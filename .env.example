# Server-only. Never expose this to the browser.
# Official name from the TypeSafe JS SDK. JEV_API_KEY is accepted as an alias.
TYPESAFE_API_KEY=
# legacy keeps the old checks. jev uses the three System One gates.
AGORA_DECIDER=legacy
# Optional. Defaults are https://api.typesafe.ai and the pinned model jev-1.13.0.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# Writing model for the swarm (Qwen Cloud OpenAI-compatible chat completions).
# Token Plan keys (sk-sp-…) use the token-plan host below — not maas.qwencloudapi.com.
# DASHSCOPE_API_KEY=
# Optional overrides (defaults match Token Plan + deepseek-v4.1-flash):
# QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
# QWEN_MODEL=deepseek-v4.1-flash
# Web search for tasks Jev marks as needing current information. Server only.
# EXA_API_KEY=
# Public HTTPS origin of this server, used as the OAuth resource identifier.
AGORA_PUBLIC_URL=
# Directory for household memory, tasks, approvals, and saved runs.
AGORA_DATA_DIR=
# OAuth client id for Alexa+ and other MCP clients.
AGORA_OAUTH_CLIENT_ID=
# OAuth client secret. Server only.
AGORA_OAUTH_CLIENT_SECRET=
# HMAC secret for signing access and refresh tokens. Server only.
AGORA_TOKEN_SECRET=
# Passcode for the one-household consent page.
AGORA_HOUSEHOLD_PASSCODE=
# Static development token for the MCP Inspector and Claude Code.
AGORA_MCP_TOKEN=
# Server model backend. Set to bedrock to call Amazon Bedrock when the browser sent no key.
AGORA_SERVER_LLM=
# AWS region for Bedrock and Polly.
AWS_REGION=
# Bedrock messages model. Default: anthropic.claude-sonnet-5
BEDROCK_MODEL=
# Faster Bedrock model for short turns. Default: anthropic.claude-haiku-4-5
BEDROCK_FAST_MODEL=
# Voice simulator model. Default: BEDROCK_FAST_MODEL
ALEXA_SIM_MODEL=
# Base URL the voice simulator uses when it calls this server. Default: http://127.0.0.1:<port>
AGORA_SELF_URL=
# Amazon Polly voice id. Default: Joanna
POLLY_VOICE=
# Amazon Polly engine. Default: neural
POLLY_ENGINE=
# Firecrawl key for web research. Server only. Falls back to Exa when unset.
FIRECRAWL_API_KEY=
