# Server-only. Never expose this to the browser.
# Official name from the TypeSafe JS SDK. JEV_API_KEY is accepted as an alias.
TYPESAFE_API_KEY=
# legacy keeps the old checks. jev uses the three System One gates.
AGORA_DECIDER=legacy
# Optional. Defaults are https://api.typesafe.ai and the pinned model jev-1.13.0.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# Writing model for the swarm (Qwen Cloud OpenAI-compatible chat completions).
# Token Plan keys (sk-sp-…) use the token-plan host below — not maas.qwencloudapi.com.
# DASHSCOPE_API_KEY=
# The server uses the Token Plan host and deepseek-v4.1-flash. It does not read QWEN_BASE_URL or QWEN_MODEL.
# Web search for tasks Jev marks as needing current information. Server only.
# EXA_API_KEY=
# Public HTTPS origin of this server, used as the OAuth resource identifier.
# Required before OAuth or /mcp will answer on a process that is not bound to loopback.
AGORA_PUBLIC_URL=
# Set to 1 to honor X-Forwarded-Proto when building the OAuth issuer and the Secure cookie.
# AGORA_TRUST_PROXY=
# Comma-separated exact redirect URIs from alexa-ai configure-account-linking.
# The simulator's own http://127.0.0.1 and http://localhost callbacks are always allowed.
# AGORA_OAUTH_REDIRECT_URIS=
# Directory for household memory, tasks, approvals, and saved runs.
AGORA_DATA_DIR=
# IANA zone for "due today", "at 6pm", and reminder times. Default: the server's zone.
# AGORA_TIMEZONE=America/Los_Angeles
# OAuth client id for Alexa+ and other MCP clients.
AGORA_OAUTH_CLIENT_ID=
# OAuth client secret. Server only.
AGORA_OAUTH_CLIENT_SECRET=
# HMAC secret for signing access and refresh tokens. Server only.
AGORA_TOKEN_SECRET=
# Passcode for the one-household consent page.
AGORA_HOUSEHOLD_PASSCODE=
# Static development token for the MCP Inspector and Claude Code. At least 32 characters.
# Ignored when NODE_ENV=production or AGORA_PUBLIC_URL is https, unless AGORA_ALLOW_DEV_TOKEN=1.
AGORA_MCP_TOKEN=
# Set to 1 to keep AGORA_MCP_TOKEN in production or behind an https public URL.
# AGORA_ALLOW_DEV_TOKEN=
# Server model backend. Set to bedrock to call Amazon Bedrock when the browser sent no key.
AGORA_SERVER_LLM=
# AWS region for Bedrock and Polly.
AWS_REGION=
# Bedrock messages model. Default: anthropic.claude-sonnet-5
BEDROCK_MODEL=
# Faster Bedrock model for short turns. Default: anthropic.claude-haiku-4-5
BEDROCK_FAST_MODEL=
# Voice simulator model. Default: BEDROCK_FAST_MODEL
ALEXA_SIM_MODEL=
# Set to 0 to send every simulator turn through the model. Unset uses the fast path for simple commands.
ALEXA_SIM_FAST_PATH=
# Base URL the voice simulator uses when it calls this server. Default: http://127.0.0.1:<port>
AGORA_SELF_URL=
# Set to 0 to skip Amazon Polly. The browser speaks instead, and a missing credential does the same.
# AGORA_TTS=
# Amazon Polly voice id. Default: Joanna
POLLY_VOICE=
# Amazon Polly engine. Default: neural
POLLY_ENGINE=
# Firecrawl key for web research. Server only. Falls back to Exa when unset.
FIRECRAWL_API_KEY=
# HTTP port for server/prod.ts. Default 8080.
# PORT=8080
# Room host code. Required for a host seat when this process binds 0.0.0.0 and no household session is used.
# DEMO_HOST_SECRET=
# Path to a recorded society run. Off unless set. Demo only.
# SOCIETY_REPLAY=
# Path to a saved benchmark result. Off unless set. Demo only.
# BENCH_REPLAY=
# Set to true to disable Vite HMR.
# DISABLE_HMR=
# NODE_ENV=production ignores AGORA_MCP_TOKEN unless AGORA_ALLOW_DEV_TOKEN=1. The container sets this. Do not set it for local dev.
