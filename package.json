{
  "name": "agora",
  "description": "Open-source workspace where people and AI agents share tasks, chat, and a Markdown document, with a 3D office and a 2D fallback",
  "license": "MIT",
  "author": "Ritesh-Root <workstationritalks@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ritesh-Root/agora.git"
  },
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "dev:lan": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node server/mcp/apps/buildCard.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:server": "tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.3",
    "@anthropic-ai/sdk": "^0.132.0",
    "@aws-sdk/client-polly": "^3.1147.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.10.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.0",
    "three-pathfinding": "^1.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.9"
  }
}
